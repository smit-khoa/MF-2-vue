# Shell (host) environment variables
# Dev: fallback trỏ về localhost:301x (xem owners.json). Production: điền CDN URLs.

# API + dashboard (dùng cho DefinePlugin)
API_GATEWAY_URL=https://gateway.smit.team
DASHBOARD_URL=https://dashboard.smit.team

# URL remotes (không có trailing slash) — override owners.json khi deploy
HOME_REMOTE_URL=https://home.yourdomain.com
ADS_ASSET_REMOTE_URL=https://ads-asset.yourdomain.com
