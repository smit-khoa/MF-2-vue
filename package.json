{
  "name": "smit-client-vue",
  "version": "0.1.0",
  "private": true,
  "description": "SMIT Agency micro-frontend client (Vue 3 + Module Federation 2.0 + Rspack)",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "dev:shell": "pnpm --filter @mf2/shell dev",
    "dev:adaccounts": "pnpm --filter @mf2/adaccounts dev",
    "dev:ads-manager": "pnpm --filter @mf2/ads-manager dev",
    "build": "node scripts/build.mjs",
    "assemble": "node scripts/assemble-dist.mjs",
    "preview": "pnpm -r --parallel --filter './apps/*' run preview",
    "typecheck": "turbo run typecheck",
    "verify:same-origin": "node scripts/verify-same-origin-remotes.mjs",
    "verify:dist": "node scripts/verify-dist-assembly.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache @mf-types"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "turbo": "^2.9.16",
    "typescript": "^5.6.3"
  }
}
